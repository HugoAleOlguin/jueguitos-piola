rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. CHAT: Lectura publica, creacion para autenticados, edicion/borrado solo por el autor
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // 2. PERFILES: Lectura publica, escritura solo por el dueno exacto del UID
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == userId;
    }

    // 3. APODOS: Lectura publica (para chequear si existe), creacion solo si NO esta tomado
    match /usernames/{username} {
      allow read: if true;
      // Solo permite crear si el nombre esta libre y le pertenece al usuario que lo registra
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/usernames/$(username))
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
